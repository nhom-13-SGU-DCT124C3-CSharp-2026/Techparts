@model Product
<div class="card h-100 product-card shadow-sm">
    <div class="img-wrap">
        @if (Model.DiscountPercent > 0)
        {
            <span class="discount-badge">-@Model.DiscountPercent%</span>
        }
        <a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? ProductImageHelper.PlaceholderFor(Model.Category?.Name) : Model.ImageUrl)"
                 class="card-img-top p-3" alt="@Model.Name" data-fallback="@ProductImageHelper.PlaceholderFor(Model.Category?.Name)" onerror="this.onerror=null;this.src=this.dataset.fallback" />
        </a>
    </div>
    <div class="card-body d-flex flex-column">
        <div class="small text-muted mb-1">@Model.Brand?.Name · @Model.Category?.Name</div>
        <h6 class="card-title">
            <a class="text-decoration-none text-dark" asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a>
        </h6>
        @if (!string.IsNullOrWhiteSpace(Model.Specifications))
        {
            <div class="spec-line mb-2">@Model.Specifications</div>
        }
        <div class="mt-auto">
            <div class="mb-1">
                <span class="price">@Model.Price.Money()</span>
                @if (Model.OldPrice.HasValue && Model.OldPrice.Value > Model.Price)
                {
                    <span class="old-price ms-1">@Model.OldPrice.Value.Money()</span>
                }
            </div>
            <div class="stock-note mb-2 @(Model.Stock is > 0 and <= 5 ? "low" : "text-muted")">
                @if (Model.Stock <= 0)
                {
                    <span class="text-secondary">Hết hàng</span>
                }
                else if (Model.Stock <= 5)
                {
                    <span><i class="bi bi-exclamation-triangle"></i> Sắp hết (còn @Model.Stock)</span>
                }
                else
                {
                    <span><i class="bi bi-check-circle"></i> Còn hàng</span>
                }
            </div>
            @if (Model.Stock > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button class="btn btn-primary btn-sm w-100"><i class="bi bi-cart-plus"></i> Thêm vào giỏ</button>
                </form>
            }
            else
            {
                <button class="btn btn-secondary btn-sm w-100" disabled>Hết hàng</button>
            }
        </div>
    </div>
</div>
