@model LoginVm
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="bg-white rounded shadow-sm p-4">
            <h4 class="mb-3">Đăng nhập</h4>
            <form method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3"><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" autofocus /><span asp-validation-for="Username" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger"></span></div>
                <div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label"></label></div>
                <button class="btn btn-primary w-100">Đăng nhập</button>
            </form>
            <div class="text-center mt-3"><a asp-action="ForgotPassword">Quên mật khẩu?</a></div>
            <div class="text-center mt-3">Chưa có tài khoản? <a asp-action="Register">Đăng ký</a></div>
@* Tài khoản mẫu CHỈ hiện ở môi trường Development (phục vụ demo/kiểm thử).
   Trên Production/Staging không hiện để tránh lộ mật khẩu demo. *@
            @if (Env.IsDevelopment())
            {
            <div class="alert alert-light border small mt-3 mb-0">
                Tài khoản mẫu:<br />Admin: <code>admin / Admin@123</code><br />Khách: <code>khach / Khach@123</code>
            </div>
            }
        </div>
    </div>
</div>
