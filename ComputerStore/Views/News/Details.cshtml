@model NewsPost
@{ ViewData["Title"] = Model.Title; }
<a asp-action="Index" class="text-decoration-none">← Tất cả bài viết</a>
<article class="bg-white rounded shadow-sm p-4 mt-3">
    <h2>@Model.Title</h2>
    <div class="text-muted mb-3"><i class="bi bi-calendar3"></i> @Model.PublishedAt.ToString("dd/MM/yyyy HH:mm")</div>
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" class="img-fluid rounded mb-3" alt="@Model.Title" onerror="this.onerror=null;this.src='/img/no-image.svg'" />
    }
    @if (!string.IsNullOrEmpty(Model.Summary))
    {
        <p class="lead">@Model.Summary</p>
    }
    @if (!string.IsNullOrEmpty(Model.Content))
    {
        @foreach (var para in Model.Content.Split(new[] { "\n" }, StringSplitOptions.RemoveEmptyEntries))
        {
            <p>@para.Trim()</p>
        }
    }
</article>
<div class="mt-3">
    <a class="btn btn-primary" asp-controller="Shop" asp-action="Index">Xem linh kiện đang bán</a>
    <a class="btn btn-outline-secondary" asp-controller="BuildPc" asp-action="Index">Mở trình Build PC</a>
</div>
