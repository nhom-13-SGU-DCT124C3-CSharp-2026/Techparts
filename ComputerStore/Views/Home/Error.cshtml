@{ ViewData["Title"] = "Lỗi"; }
<div class="text-center py-5">
    <h1 class="text-danger">Đã có lỗi xảy ra</h1>
    <p class="text-muted">Vui lòng thử lại sau.</p>
    @if (ViewData["RequestId"] != null)
    {
        <p class="text-muted small">Mã yêu cầu: <code>@ViewData["RequestId"]</code> — hãy gửi mã này cho quản trị viên khi báo lỗi để đối chiếu với nhật ký hệ thống.</p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
</div>
