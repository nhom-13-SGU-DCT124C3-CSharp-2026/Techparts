@model CheckoutVm
@{ ViewData["Title"] = "Thanh toán"; }
<h3 class="mb-3">Thanh toán</h3>
<div class="row g-4">
    <div class="col-lg-7">
        <form method="post" id="checkoutForm" class="bg-white rounded shadow-sm p-4">
            <h5 class="mb-3">Thông tin giao hàng</h5>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="VoucherCode" />
            <div class="mb-3"><label asp-for="ReceiverName" class="form-label"></label><input asp-for="ReceiverName" class="form-control" /><span asp-validation-for="ReceiverName" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="ShippingAddress" class="form-label"></label><input asp-for="ShippingAddress" class="form-control" /><span asp-validation-for="ShippingAddress" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Note" class="form-label"></label><textarea asp-for="Note" class="form-control" rows="2"></textarea></div>

            <h5 class="mb-3 mt-4">Hình thức thanh toán</h5>
            @foreach (var pm in Model.PaymentMethods)
            {
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="PaymentMethodId" id="pm@(pm.Id)" value="@pm.Id" checked="@(Model.PaymentMethodId == pm.Id)" />
                    <label class="form-check-label" for="pm@(pm.Id)">@pm.Name</label>
                </div>
            }
            <span asp-validation-for="PaymentMethodId" class="text-danger"></span>
            <p class="text-muted small mt-2">Thanh toán online không thực hiện theo yêu cầu của nhóm — chỉ dùng COD hoặc chuyển khoản.</p>
        </form>
    </div>
    <div class="col-lg-5">
        <div class="bg-white rounded shadow-sm p-4">
            <h5 class="mb-3">Đơn hàng của bạn</h5>
            @foreach (var it in Model.Items)
            {
                <div class="d-flex justify-content-between mb-2">
                    <div>@it.Product.Name <span class="text-muted">× @it.Quantity</span></div>
                    <div>@it.LineTotal.Money()</div>
                </div>
            }
            <hr />
            <div class="d-flex justify-content-between mb-2"><span>Tạm tính</span><span>@Model.Total.Money()</span></div>
            <div class="d-flex justify-content-between mb-2"><span>Phí vận chuyển</span><span>@(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.Money())</span></div>
            @if (Model.DiscountAmount > 0)
            {
                <div class="d-flex justify-content-between mb-2"><span>Giảm giá (@Model.VoucherCode)</span><span class="text-success">-@Model.DiscountAmount.Money()</span></div>
            }
            <div class="d-flex justify-content-between fs-5"><strong>Tổng cộng</strong><span class="price">@Model.GrandTotal.Money()</span></div>
            @* Nút nằm ngoài form đặt hàng nên dùng thuộc tính form để submit form #checkoutForm. *@
            <button form="checkoutForm" class="btn btn-success btn-lg w-100 mt-3">Đặt hàng</button>
            <a class="btn btn-link w-100" asp-action="Index">Quay lại giỏ hàng</a>
        </div>
        <div class="bg-white rounded shadow-sm p-4 mt-3">
            <h5 class="mb-3">Mã giảm giá</h5>
            @* Form riêng (GET) để áp mã trước khi đặt hàng — KHÔNG lồng trong form đặt hàng.
               Mã đã áp được giữ lại trong form đặt hàng qua hidden input VoucherCode. *@
            <form method="get" asp-action="Checkout">
                <div class="input-group">
                    <input type="text" name="voucherCode" class="form-control" value="@Model.VoucherCode" placeholder="VD: WELCOME10" />
                    <button class="btn btn-outline-primary">Áp dụng</button>
                </div>
            </form>
            @if (ViewBag.VoucherError != null)
            {
                <div class="text-danger small mt-2">@ViewBag.VoucherError</div>
            }
            @if (ViewBag.VoucherOk != null)
            {
                <div class="text-success small mt-2">@ViewBag.VoucherOk</div>
            }
            <span class="text-danger small">@Html.ValidationMessage("VoucherCode")</span>
            <p class="text-muted small mt-2 mb-0">Mã mẫu: WELCOME10 (giảm 10%, tối đa 500.000₫, đơn từ 500.000₫), GIAM50K (giảm 50.000₫, đơn từ 1.000.000₫).</p>
        </div>
    </div>
</div>
