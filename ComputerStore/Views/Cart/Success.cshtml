@model Order
@{ ViewData["Title"] = "Đặt hàng thành công"; }
<div class="text-center bg-white rounded shadow-sm p-5">
    <i class="bi bi-check-circle-fill text-success" style="font-size:4rem"></i>
    <h3 class="mt-3">Đặt hàng thành công!</h3>
    <p>Mã đơn hàng: <strong>#@Model.Id</strong></p>
    <div class="mx-auto text-start" style="max-width: 420px">
        <div class="d-flex justify-content-between mb-1"><span>Tạm tính</span><span>@((Model.Total - Model.ShippingFee + Model.DiscountAmount).Money())</span></div>
        <div class="d-flex justify-content-between mb-1"><span>Phí vận chuyển</span><span>@(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.Money())</span></div>
        @if (Model.DiscountAmount > 0)
        {
            <div class="d-flex justify-content-between mb-1"><span>Giảm giá (@Model.VoucherCode)</span><span class="text-success">-@Model.DiscountAmount.Money()</span></div>
        }
        <hr />
        <div class="d-flex justify-content-between fs-5"><strong>Tổng tiền</strong><strong class="price">@Model.Total.Money()</strong></div>
    </div>
    <p class="text-muted mt-3">Hình thức thanh toán: @Model.PaymentMethod.Name</p>
    @{
        var bankLines = ViewBag.BankTransferLines as string[];
    }
    @if (bankLines != null)
    {
        <div class="alert alert-info text-start mx-auto" style="max-width: 520px">
            <strong>Chuyển khoản ngân hàng</strong>
            @foreach (var line in bankLines)
            {
                <div>@line</div>
            }
        </div>
    }
    <a class="btn btn-primary" asp-controller="Account" asp-action="OrderDetail" asp-route-id="@Model.Id">Xem đơn hàng</a>
    <a class="btn btn-outline-secondary" asp-controller="Shop" asp-action="Index">Tiếp tục mua sắm</a>
</div>
