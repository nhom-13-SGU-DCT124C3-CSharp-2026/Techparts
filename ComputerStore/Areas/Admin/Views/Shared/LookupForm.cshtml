@model LookupEntity
@{
    var heading = (string)ViewData["Heading"];
    var isEdit = Model.Id > 0;
    ViewData["Title"] = (isEdit ? "Sửa " : "Thêm ") + heading.ToLower();
}
<h3 class="mb-3">@ViewData["Title"]</h3>
<form method="post" class="bg-white rounded shadow-sm p-4" style="max-width:600px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autofocus />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <button class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
</form>
