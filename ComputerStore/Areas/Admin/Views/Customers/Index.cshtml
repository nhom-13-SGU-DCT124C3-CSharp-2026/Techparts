@model List<Customer>
@{ ViewData["Title"] = "Khách hàng"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Khách hàng</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm khách hàng</a>
</div>
<form method="get" class="d-flex gap-2 mb-3" style="max-width:420px">
    <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tên, SĐT, email..." />
    <button class="btn btn-outline-secondary">Tìm</button>
</form>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>#</th><th>Họ tên</th><th>SĐT</th><th>Email</th><th>Địa chỉ</th><th>Ngày tạo</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td><td class="fw-semibold">@c.FullName</td><td>@c.Phone</td><td>@c.Email</td><td>@c.Address</td>
                <td>@c.CreatedAt.ToString("dd/MM/yyyy")</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                </td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">Không có dữ liệu</td></tr> }
        </tbody>
    </table>
</div>

@* B-8: phân trang 20/trang *@
@if ((int)ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-q="@ViewBag.Q">@i</a>
                </li>
            }
        </ul>
    </nav>
}
