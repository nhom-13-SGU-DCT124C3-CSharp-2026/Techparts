@model StockReceipt
@{ ViewData["Title"] = "Phiếu nhập PN#" + Model.Id; }
<a asp-action="Index" class="text-decoration-none">← Danh sách phiếu nhập</a>
<h3 class="my-3">Phiếu nhập PN#@Model.Id</h3>
<div class="mb-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Sửa phiếu nhập</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">Xóa phiếu nhập</a>
</div>
<div class="bg-white rounded shadow-sm p-3 mb-3">
    <div><strong>Ngày nhập:</strong> @Model.ReceiptDate.ToString("dd/MM/yyyy HH:mm")</div>
    <div><strong>Nhà cung cấp:</strong> @Model.Supplier</div>
    <div><strong>Ghi chú:</strong> @Model.Note</div>
</div>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table mb-0 align-middle">
        <thead class="table-light"><tr><th>Linh kiện</th><th class="text-center">Số lượng</th><th class="text-end">Giá nhập</th><th class="text-end">Thành tiền</th></tr></thead>
        <tbody>
        @foreach (var d in Model.Details)
        {
            <tr><td>@d.Product.Name <span class="text-muted small">(@d.Product.Sku)</span></td><td class="text-center">@d.Quantity</td><td class="text-end">@d.UnitCost.Money()</td><td class="text-end">@((d.UnitCost * d.Quantity).Money())</td></tr>
        }
        </tbody>
        <tfoot><tr><th colspan="3" class="text-end">Tổng cộng</th><th class="text-end">@Model.Total.Money()</th></tr></tfoot>
    </table>
</div>
