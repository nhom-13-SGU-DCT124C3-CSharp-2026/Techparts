@model List<Product>
@{ ViewData["Title"] = "Linh kiện"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Linh kiện</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm linh kiện</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tên hoặc mã SKU..." /></div>
    <div class="col-md-3"><select name="categoryId" class="form-select" asp-items="@((SelectList)ViewBag.Categories)"><option value="">-- Loại --</option></select></div>
    <div class="col-md-3"><select name="brandId" class="form-select" asp-items="@((SelectList)ViewBag.Brands)"><option value="">-- Thương hiệu --</option></select></div>
    <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Lọc</button></div>
</form>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th></th><th>Tên / SKU</th><th>Loại</th><th>Nhóm</th><th>Hãng</th><th class="text-end">Giá</th><th class="text-center">Tồn</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td><img class="thumb" src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/img/no-image.svg" : p.ImageUrl)" alt="" onerror="this.onerror=null;this.src='/img/no-image.svg'" /></td>
                <td><div class="fw-semibold">@p.Name</div><div class="small text-muted">@p.Sku</div></td>
                <td>@p.Category.Name</td>
                <td>@p.Group.Name</td>
                <td>@p.Brand.Name</td>
                <td class="text-end">@p.Price.Money()</td>
                <td class="text-center"><span class="badge @(p.Stock <= 5 ? "bg-danger" : "bg-success")">@p.Stock</span></td>
                <td>@(p.IsActive ? "Đang bán" : "Ẩn")</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa linh kiện này?');">
                        <button class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="9" class="text-center text-muted py-4">Không có dữ liệu</td></tr> }
        </tbody>
    </table>
</div>

@* B-8: phân trang 20/trang *@
@if ((int)ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-q="@ViewBag.Q"
                       asp-route-categoryId="@ViewBag.CategoryId" asp-route-brandId="@ViewBag.BrandId">@i</a>
                </li>
            }
        </ul>
    </nav>
}
