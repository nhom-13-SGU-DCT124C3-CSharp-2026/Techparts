@model Voucher
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm mã giảm giá" : "Sửa mã giảm giá"; }
<h3 class="mb-3">@ViewData["Title"]</h3>
<form method="post" class="bg-white rounded shadow-sm p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @if (Model.Id != 0) { <input type="hidden" asp-for="Id" /> }
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control text-uppercase" placeholder="VD: WELCOME10" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DiscountType" class="form-label"></label>
            <select asp-for="DiscountType" class="form-select" asp-items="Html.GetEnumSelectList<DiscountType>()"></select>
            <span asp-validation-for="DiscountType" class="text-danger"></span>
        </div>
    </div>
    <div class="row g-3 mt-1">
        <div class="col-md-4">
            <label asp-for="DiscountValue" class="form-label"></label>
            <input asp-for="DiscountValue" type="number" min="0" step="1" class="form-control" />
            <span class="form-text">Loại %: nhập 1–100. Loại cố định: nhập số tiền (₫).</span>
            <span asp-validation-for="DiscountValue" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="MinOrderAmount" class="form-label"></label>
            <input asp-for="MinOrderAmount" type="number" min="0" step="1000" class="form-control" />
            <span asp-validation-for="MinOrderAmount" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="MaxDiscountAmount" class="form-label"></label>
            <input asp-for="MaxDiscountAmount" type="number" min="0" step="1000" class="form-control" />
            <span class="form-text">Chỉ dùng cho loại %; để trống nếu không giới hạn.</span>
            <span asp-validation-for="MaxDiscountAmount" class="text-danger"></span>
        </div>
    </div>
    <div class="row g-3 mt-1">
        <div class="col-md-6">
            <label asp-for="ValidFrom" class="form-label"></label>
            <input asp-for="ValidFrom" type="datetime-local" class="form-control" value="@Model.ValidFrom.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="ValidFrom" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ValidTo" class="form-label"></label>
            <input asp-for="ValidTo" type="datetime-local" class="form-control" value="@Model.ValidTo.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="ValidTo" class="text-danger"></span>
        </div>
    </div>
    <div class="row g-3 mt-1">
        <div class="col-md-6">
            <label asp-for="MaxUses" class="form-label"></label>
            <input asp-for="MaxUses" type="number" min="1" class="form-control" />
            <span asp-validation-for="MaxUses" class="text-danger"></span>
        </div>
        <div class="col-md-6 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>
    @if (Model.Id != 0)
    {
        <p class="text-muted small mt-3">Đã dùng: @Model.UsedCount / @Model.MaxUses lượt (số lượt chỉ tăng khi đơn được tạo thành công, không sửa tay).</p>
    }
    <div class="mt-3">
        <button class="btn btn-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-link">Quay lại</a>
    </div>
</form>
