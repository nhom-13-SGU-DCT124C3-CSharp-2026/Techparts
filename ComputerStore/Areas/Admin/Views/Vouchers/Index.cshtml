@model List<Voucher>
@{ ViewData["Title"] = "Mã giảm giá"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Mã giảm giá</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm mã giảm giá</a>
</div>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Mã</th><th>Loại giảm</th><th>Giá trị</th><th>Đơn tối thiểu</th><th>Giảm tối đa</th><th>Hiệu lực</th><th>Đã dùng</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td class="fw-semibold">@v.Code</td>
                <td>@(v.DiscountType == DiscountType.Percent ? "Theo %" : "Số tiền cố định")</td>
                <td>@(v.DiscountType == DiscountType.Percent ? v.DiscountValue.ToString("N0") + "%" : v.DiscountValue.Money())</td>
                <td>@v.MinOrderAmount.Money()</td>
                <td>@(v.MaxDiscountAmount.HasValue ? v.MaxDiscountAmount.Value.Money() : "—")</td>
                <td>@v.ValidFrom.ToString("dd/MM/yyyy") – @v.ValidTo.ToString("dd/MM/yyyy")</td>
                <td>@v.UsedCount / @v.MaxUses</td>
                <td>@(v.IsActive ? "Đang áp dụng" : "Đã tắt")</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@v.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa mã giảm giá này?');">
                        <button class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="9" class="text-center text-muted py-4">Chưa có mã giảm giá</td></tr> }
        </tbody>
    </table>
</div>

@if ((int)ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
