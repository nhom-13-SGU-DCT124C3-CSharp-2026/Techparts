@model List<Order>
@{ ViewData["Title"] = "Đơn hàng"; var status = (OrderStatus?)ViewBag.Status; }
<h3 class="mb-3">Đơn hàng</h3>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tên khách hoặc SĐT..." /></div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">-- Tất cả trạng thái --</option>
            @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
            {
                <option value="@((int)s)" selected="@(status == s)">@s.Text()</option>
            }
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Lọc</button></div>
</form>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Mã</th><th>Khách hàng</th><th>Ngày đặt</th><th>Thanh toán</th><th class="text-end">Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>#@o.Id</td>
                <td>@o.Customer.FullName<div class="small text-muted">@o.Phone</div></td>
                <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@o.PaymentMethod.Name <span class="badge @(o.IsPaid ? "bg-success" : "bg-light text-dark border")">@(o.IsPaid ? "Đã thanh toán" : "Chưa thanh toán")</span></td>
                <td class="text-end">@o.Total.Money()</td>
                <td><span class="badge @o.Status.Badge()">@o.Status.Text()</span></td>
                <td class="text-end"><a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a></td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">Không có đơn hàng</td></tr> }
        </tbody>
    </table>
</div>

@* B-8: phân trang 20/trang *@
@if ((int)ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-q="@ViewBag.Q"
                       asp-route-status="@ViewBag.StatusValue">@i</a>
                </li>
            }
        </ul>
    </nav>
}
