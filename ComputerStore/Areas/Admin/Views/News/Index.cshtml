@model List<NewsPost>
@{ ViewData["Title"] = "Tin tức"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Tin tức</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Đăng bài viết</a>
</div>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Tiêu đề</th><th>Ngày đăng</th><th>Hiển thị</th><th></th></tr></thead>
        <tbody>
        @foreach (var n in Model)
        {
            <tr>
                <td>
                    <div class="fw-semibold">@n.Title</div>
                    <div class="small text-muted">@n.Summary</div>
                </td>
                <td>@n.PublishedAt.ToString("dd/MM/yyyy")</td>
                <td>@(n.IsPublished ? "Hiển thị" : "Ẩn")</td>
                <td class="text-end text-nowrap">
                    <a asp-area="" asp-controller="News" asp-action="Details" asp-route-id="@n.Id" target="_blank" class="btn btn-sm btn-outline-secondary">Xem</a>
                    <a asp-action="Edit" asp-route-id="@n.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@n.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa bài viết này?');">
                        <button class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">Chưa có bài viết</td></tr> }
        </tbody>
    </table>
</div>

@if ((int)ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
